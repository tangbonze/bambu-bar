{
  "name": "bambu-bar-tauri",
  "version": "1.0.4",
  "private": true,
  "description": "Bambu Bar — 拓竹打印机菜单栏看板（Tauri 2 跨平台版）",
  "scripts": {
    "build:ui": "esbuild ui/core-entry.js --bundle --format=iife --platform=browser --target=es2020 --outfile=ui/core.bundle.js",
    "dev": "npx tauri dev",
    "build": "npx tauri build",
    "build:debug": "cargo build --manifest-path src-tauri/Cargo.toml",
    "test": "node --test \"test/*.test.js\" && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:js": "node --test \"test/*.test.js\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dist": "./scripts/make-dmg.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2"
  }
}
